# (Optional constraint) Garmin Connect credentials for fetching real health data
# If these are left blank or invalid, the app will gracefully fall back to mock data
GARMIN_EMAIL="your_garmin_email@example.com"
GARMIN_PASSWORD="your_garmin_password"

# Optional: Garmin Sign In Breadcrumbs for handling MFA or specific login flows
# Required for Docker deployments to ensure login scripts find necessary UI elements
GARMIN_SIGN_IN_BREADCRUMBS="email,password"

# Deepseek API Key for health analysis
DEEPSEEK_API_KEY="your_deepseek_api_key_here"